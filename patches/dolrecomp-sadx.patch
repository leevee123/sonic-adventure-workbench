+static int patch_word(const char* path, long offset, u32 word) {
+    FILE* file = fopen(path, "r+b");
+    u8 bytes[4];
+    write_be32(bytes, word);
+    if (!file) return 0;
+    int ok = fseek(file, offset, SEEK_SET) == 0 &&
+             fwrite(bytes, 1, 4, file) == 4;
+    return fclose(file) == 0 && ok;
+}
+
+static int test_module_alignment_not_text_alignment(void) {
+    const char* path = "test_sadx_alignment.rel";
+    CHECK(write_sample_rel(path, 1, R_PPC_ADDR32, 2, 0, 8) &&
+          patch_word(path, 0x40, 8) && patch_word(path, 0x58, 0x105) &&
+          patch_word(path, 0x60, 0x10C), "failed to write SADX alignment fixture");
+    RELFile rel;
+    CHECK(rel_load_image(&rel, path, 0x80500000u),
+          "eight-byte module allocation must permit four-byte-aligned text");
+    CHECK(rel.sections[1].address == 0x80500104u, "incorrect section address");
+    rel_free(&rel);
+    CHECK(!rel_load_image(&rel, path, 0x80500004u),
+          "misaligned module allocation must still be rejected");
+    remove(path);
+    return 1;
+}
+
+static int test_data_only_module(void) {
+    const char* path = "test_data_only.rel";
+    CHECK(write_sample_rel(path, 1, R_PPC_ADDR32, 2, 0, 8) &&
+          patch_word(path, 0x58, 0x100) && patch_word(path, 0x30, 0),
+          "failed to write data-only fixture");
+    RELFile rel;
+    CHECK(rel_load(&rel, path, 0x80500000u), "valid data-only module rejected");
+    CHECK(rel.entry_point == 0 && !rel.sections[1].executable,
+          "data-only module acquired a code entry point");
+    CHECK(read_be32(rel.sections[1].data) == 0x80500108u,
+          "data-only relocation was not applied");
+    rel_free(&rel);
+    remove(path);
+    return 1;
+}
+
+static int test_v1_has_no_alignment_fields(void) {
+    const char* path = "test_v1.rel";
+    CHECK(write_sample_rel(path, 1, R_PPC_ADDR32, 2, 0, 8) &&
+          patch_word(path, 0x1C, 1) && patch_word(path, 0x40, 0xDEADBEEF),
+          "failed to write v1 fixture");
+    RELFile rel;
+    CHECK(rel_load_image(&rel, path, 0x80500000u),
+          "v1 module must not interpret later header fields as alignment");
+    rel_free(&rel);
+    remove(path);
+    return 1;
+}
